# ============================================================
# LinkedIn Job Hunter — Environment Configuration Template
# ============================================================
# Copy this file to .env and adjust values for your environment.
# Lines starting with # are comments. Do not wrap values in quotes.
# Shell environment variables will override these values.
# ============================================================

# LLM Configuration (Local LM Studio / OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.5-4b

# Chrome Remote Debugging (CDP)
CHROME_CDP_URL=http://localhost:9222

# ============================================================
# Job Targets & Matching Thresholds
# ============================================================
# Daily target: How many high-scoring matched jobs (score >= 70%) to find per run
DAILY_TARGET_MATCHES=10
DEFAULT_MIN_MATCHES=10

# Minimum AI match score (0-100) required to save a job (below this is skipped)
DEFAULT_MIN_SCORE=70
FEED_MIN_SCORE=65

# Search pagination bounds per query
DEFAULT_MAX_PAGES_PER_QUERY=2
DEFAULT_JOB_LIMIT=50

# Safety ceiling: Maximum total jobs the AI is allowed to evaluate per session
DAILY_EVALUATE_CAP=120

# Maximum scrolls to perform when scanning LinkedIn News Feed for hiring posts
MAX_FEED_SCROLLS=80

# Output folder where jobs are saved (output/jobs_report.md, jobs.csv, matched_jobs.json)
OUTPUT_DIR=output

# Search Queries (comma-separated query rotation)
DEFAULT_QUERIES=UI/UX Designer,Product Designer,Figma Designer,UI Designer,Design Systems Designer

# Human Delays (0 / 0.0 = completely removed for maximum speed)
ENABLE_HUMAN_DELAYS=0
HUMAN_DELAY_MIN=0.0
HUMAN_DELAY_MAX=0.0
CARD_CLICK_DELAY_MIN=0.0
CARD_CLICK_DELAY_MAX=0.0
SCROLL_DELAY=0.5

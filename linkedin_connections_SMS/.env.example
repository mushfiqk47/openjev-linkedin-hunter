# ============================================================
# LinkedIn Outreach Agent - Configuration
# Copy this file to data/.env and edit the values there; every
# `python agent.py` command reads it on start.
# Lines starting with # are comments. Do not wrap values in quotes.
# A value set in your PowerShell session overrides the .env value.
# ============================================================

# LinkedIn connections page URL (where contacts are harvested from)
LINKEDIN_CONNECTIONS_URL=https://www.linkedin.com/mynetwork/invite-connect/connections/

# How many new contacts to harvest per run
TOP_N=25

# Daily message send limit (safety cap per calendar day - the "SMS" limit)
DAILY_LIMIT=15

# Seconds to wait between consecutive sends (anti-spam pacing).
# Actual delay is randomized between PACING and PACING*PACING_JITTER -
# fixed intervals look bot-like; jitter keeps the account safer.
PACING=6
PACING_JITTER=2.5

# Attempts per contact for FAILED sends.
# UNKNOWN outcomes (maybe delivered) are NEVER retried, so no duplicates.
MAX_ATTEMPTS=2

# Live thread pre-check before sending (1=on, 0=off). Opens the contact's
# LinkedIn conversation; if it already has messages, the contact is logged
# SKIPPED instead of being messaged again. This guards against duplicates at
# the source of truth, not just the local ledger.
THREAD_CHECK=1

# 1 = also SKIP when the thread check is inconclusive (no THREAD result,
# composer never mounted). Safest against duplicates; may skip open/invalid
# conversations. 0 = send anyway and rely on the ledger for dedup.
THREAD_CHECK_STRICT=0

# Resume offset into the pending (unsent) contact list
START_IDX=0

# People-search pagination bounds (used by fetch_search_connections.py)
MAX_PAGES=10
START_PAGE=1

# People-search sweep bound for fetch_connections.py (it must pass many
# already-messaged pages before it finds new contacts)
SEARCH_MAX_PAGES=50

# Seconds before a hung browser-use call is killed (protects the batch)
BU_TIMEOUT=180

# Portfolio URL included in the outreach message
PORTFOLIO_URL=https://mushfiqkabiruix.vercel.app/

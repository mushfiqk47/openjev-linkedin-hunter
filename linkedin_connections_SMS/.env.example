# ============================================================
# LinkedIn Network Outreach Agent — Environment Configuration
# ============================================================
# This file is automatically loaded on startup by `python agent.py`.
# Lines starting with # are comments. Do not wrap values in quotes.
# Shell environment variables will override the values set here.
# ============================================================

# Target number of unsent contacts to maintain in candidate pool
TOP_N=40

# Daily message safety cap per calendar day (the "SMS" limit)
DAILY_LIMIT=100

# Anti-spam pacing delay between consecutive sends (in seconds)
# Pacing interval is randomized between PACING and PACING * PACING_JITTER
PACING=6
PACING_JITTER=2.5

# Retry attempts for transient delivery failures (UNKNOWN outcomes are never retried)
MAX_ATTEMPTS=2

# Live conversation thread check (1 = enabled, 0 = disabled)
# Runs once for newly discovered contacts to prevent any duplicate DMs
THREAD_CHECK=1
THREAD_CHECK_STRICT=0

# People Search pagination bounds for network sweeps
START_PAGE=1
MAX_PAGES=20
SEARCH_MAX_PAGES=50

# Mode settings:
# DRY_RUN: 1 = simulate outreach without sending DMs or writing to ledger, 0 = live dispatch
DRY_RUN=0

# SEARCH_ONLY: 1 = skip connections page and sweep 1st-degree People Search directly, 0 = normal
SEARCH_ONLY=0

# Optional pause (in seconds) between harvest and dispatch for review (0 = no pause)
PAUSE=0

# Seconds before a hung browser call is killed (protects the batch)
BU_TIMEOUT=180

# Portfolio URL embedded into the outreach message templates
PORTFOLIO_URL=https://mushfiqkabiruix.vercel.app/

# LinkedIn Connections URL
LINKEDIN_CONNECTIONS_URL=https://www.linkedin.com/mynetwork/invite-connect/connections/

# ============================================================
# SemIf Decision Backend (LM Studio / qwen3.5-4b)
# ============================================================
# Enable SemIf contact qualification and archetype classification (1=on, 0=off)
SEMIF_ENABLED=1

# LM Studio OpenAI-compatible endpoint with logprob support
SEMIF_BASE_URL=http://localhost:1234/v1

# Target hosted model
SEMIF_MODEL=qwen3.5-4b

# Minimum relevance score (0-100) required to send a message (default: 50)
MIN_RELEVANCE_SCORE=50

# Filter out low-relevance contacts to save daily limit budget (1=skip low score, 0=send anyway)
FILTER_LOW_RELEVANCE=1

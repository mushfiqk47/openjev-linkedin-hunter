# SemIf remote backend. Copy to `.env` and edit (never commit `.env`).
# The scorer reads these automatically from `./.env` (or `--env-file PATH`).
# Explicit CLI flags override these values.

# LM Studio default; Ollama uses http://localhost:11434/v1
SEMIF_REMOTE_BASE_URL=http://localhost:1234/v1
# Server-side model ID, as shown by the host server
SEMIF_REMOTE_MODEL=qwen3.5-4b
# Free-form provenance label (server build, model file, date)
SEMIF_REMOTE_REVISION=lm-studio-local
# Bearer token; LM Studio accepts any non-empty value by default
SEMIF_REMOTE_API_KEY=lm-studio
# Optional: seconds per decision (default 120)
#SEMIF_REMOTE_TIMEOUT=120
# Optional: top logprobs per decision, 2-20 (default 20)
#SEMIF_REMOTE_TOP_LOGPROBS=20
# Reasoning effort for thinking models like Qwen3.5: without 'none' the model
# spends the single answer token on thinking and returns no logprobs.
# Empty value omits the parameter (for servers that reject it).
SEMIF_REMOTE_REASONING_EFFORT=none

# --- TypeSafe (Jev) proxy: `semif-proxy` --------------------------------
# Paste the real TypeSafe key below (never commit this file).
TYPESAFE_API_KEY=
# Optional: override the upstream host.
#TYPESAFE_API_BASE=https://api.typesafe.ai
# Generated by `semif-proxy --generate-key`; clients send this local key.
#SEMIF_PROXY_API_KEY=sk-semif-...
#SEMIF_PROXY_HOST=127.0.0.1
#SEMIF_PROXY_PORT=4001
#SEMIF_PROXY_TIMEOUT=120

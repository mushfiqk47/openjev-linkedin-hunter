# ============================================================
# LinkedIn Targeted Connection Agent — Environment Configuration
# ============================================================

# Target Queries to discover 2nd-degree connections (comma-separated)
TARGET_QUERIES=Head of Design,Creative Director,Technical Recruiter,Startup Founder,Product Design Manager,Design Lead,Talent Partner,VP Design,Co-Founder CEO

# Daily safety cap: Maximum connection requests to send per day/session (Recommended: 15-20)
DAILY_CONNECT_LIMIT=15

# Minimum AI evaluation score (0-100) required to send a connection request
MIN_CONNECT_SCORE=75

# Maximum search result pages to scan per query
MAX_PAGES_PER_QUERY=3

# Delay in seconds between connection dispatches
CONNECT_DELAY=3.0

# Scroll pause delay in seconds to allow LinkedIn cards to render
SCROLL_DELAY=0.5

# Dry run simulation mode (1 = test scoring without clicking Connect, 0 = live requests)
DRY_RUN=0

# Chrome Remote Debugging (CDP)
CHROME_CDP_URL=http://localhost:9222

# Local LM Studio / SemIf LLM endpoint
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.5-4b
